<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <header>
        <%- include("navbar", { link: link }) %>
    </header>
    <main>
        <h1><%= title %></h1>

        <% messages.map((message) => { %> 
            <div class="msg-group">
                <p><%= message.text %></p>
                <p><%= message.user %></p>
                <p><%= message.added %></p>

                <% const query = new URLSearchParams ({ text: message.text, user: message.user, added: message.added }).toString(); %>

                <a href="/detail?<%= query %>">Open</a>
            </div>
        <% }) %>
    </main>
</body>
</html>